{
  "name": "compuquiet-ui",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test --test-reporter=spec ui/src/*.test.ts",
    "e2e": "npm run e2e:build && wdio run e2e/wdio.conf.ts",
    "e2e:build": "tauri build --debug --no-bundle --features fake-platform --config e2e/tauri.conf.json",
    "e2e:run": "wdio run e2e/wdio.conf.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@wdio/cli": "^9.31.9",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "prettier": "3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
