{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CompuQuiet",
  "version": "1.1.2",
  "identifier": "co.swatto.compuquiet",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CompuQuiet",
        "width": 1040,
        "height": 700,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0c0f14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "Utility",
    "shortDescription": "Free the machine for games and local AI",
    "longDescription": "Parks background services and processes, switches to a performance power plan and reclaims memory so games and local AI get the whole machine, then restores everything it changed with one click.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
